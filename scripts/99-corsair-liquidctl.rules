# udev rules for Corsair liquid cooling devices
# This file should be placed in /etc/udev/rules.d/

# Corsair Commander Core/Pro/XT
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c32", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c33", MODE="0666", GROUP="plugdev"

# Corsair H100i, H115i, H150i Elite Capellix
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c32", MODE="0666", GROUP="plugdev"

# Corsair Commander ST
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c32", MODE="0666", GROUP="plugdev"

# Corsair H100i RGB Platinum
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c32", MODE="0666", GROUP="plugdev"

# Corsair H115i RGB Platinum
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c32", MODE="0666", GROUP="plugdev"

# Corsair H150i RGB Pro XT
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c32", MODE="0666", GROUP="plugdev"

# Generic Corsair USB devices
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", MODE="0666", GROUP="plugdev"

# HID devices for Corsair
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", MODE="0666", GROUP="plugdev"
